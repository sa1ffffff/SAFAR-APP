<?xml version="1.0" encoding="utf-8"?>
<!--
  RIDE AD ITEM
  ────────────
  • MaterialCardView replaces CardView → gets MD3 ripple + shape system.
  • Yellow accent strip at top gives brand identity.
  • Profile photo uses CircleImageView (de.hdodenhof).
  • MD3 typography applied to all text fields.
  • Seat count uses a surface-variant chip style.
  • All IDs unchanged → RideAdAdapter.java needs no changes.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="4dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/md_surface_variant"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:rippleColor="@color/md_ripple_dark"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Yellow accent strip at card top -->
        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="@color/md_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Route: biggest text -->
            <TextView
                android:id="@+id/tvRoute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Type.TitleMedium"
                android:textColor="@color/md_on_surface"
                android:text="Lahore  →  Islamabad" />

            <!-- Vehicle optional line -->
            <TextView
                android:id="@+id/tvVehicle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textAppearance="@style/Type.LabelMedium"
                android:textColor="@color/md_on_surface_variant"
                android:visibility="gone" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/md_outline_variant" />

            <!-- Date + seats + status row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Clock icon + date/time -->
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_time"
                    app:tint="@color/md_on_surface_variant"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:id="@+id/tvDateTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/Type.BodyMedium"
                    android:textColor="@color/md_on_surface_variant" />

                <!-- Seats chip -->
                <TextView
                    android:id="@+id/tvSeats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_seat_pill"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textAppearance="@style/Type.LabelMedium"
                    android:textColor="@color/md_on_primary" />

                <!-- Status badge -->
                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/Type.LabelMedium"
                    android:textColor="@color/status_open"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Creator row: photo + name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <!-- Profile photo (Glide loads into this) -->
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/ivCreatorPhoto"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_person_placeholder"
                    app:civ_border_color="@color/md_primary"
                    app:civ_border_width="1.5dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvPostedBy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/Type.LabelMedium"
                    android:textColor="@color/md_on_surface_variant" />

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
