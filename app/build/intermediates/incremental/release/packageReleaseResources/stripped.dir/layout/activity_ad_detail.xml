<?xml version="1.0" encoding="utf-8"?>
<!--
  AD DETAIL
  ─────────
  • CoordinatorLayout + AppBarLayout → status bar safe, collapses nicely.
  • All card backgrounds use md_surface_variant.
  • Owner/requester action sections visibility is toggled in Java (unchanged).
  • All IDs identical → zero Java changes needed.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_surface"
        android:fitsSystemWindows="true"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.SAFAR.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize" />

    </com.google.android.material.appbar.AppBarLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/md_primary"
        android:visibility="gone" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="1"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="32dp">

            <!-- ── Route card ──────────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SAFAR.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/md_surface_variant"
                app:cardCornerRadius="20dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- From row -->
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <View android:layout_width="10dp" android:layout_height="10dp"
                            android:background="@drawable/dot_green" />
                        <TextView android:id="@+id/tvOrigin"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginStart="14dp"
                            android:textAppearance="@style/Type.TitleLarge"
                            android:textColor="@color/md_on_surface" />
                    </LinearLayout>

                    <!-- Vertical connector line -->
                    <View android:layout_width="2dp" android:layout_height="20dp"
                        android:layout_marginStart="4dp" android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:background="@color/md_outline_variant" />

                    <!-- To row -->
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <View android:layout_width="10dp" android:layout_height="10dp"
                            android:background="@drawable/dot_yellow" />
                        <TextView android:id="@+id/tvDestination"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginStart="14dp"
                            android:textAppearance="@style/Type.TitleLarge"
                            android:textColor="@color/md_on_surface" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Info card ───────────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SAFAR.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/md_surface_variant"
                app:cardCornerRadius="20dp"
                app:strokeWidth="0dp">

                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp" android:paddingEnd="20dp"
                    android:paddingTop="16dp" android:paddingBottom="8dp">

                    <!-- Time row -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_time" app:tint="@color/md_primary" />
                        <TextView android:id="@+id/tvDepartureTime"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginStart="14dp"
                            android:textAppearance="@style/Type.BodyLarge"
                            android:textColor="@color/md_on_surface" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/md_outline_variant" />

                    <!-- Seats row -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_seat" app:tint="@color/md_primary" />
                        <TextView android:id="@+id/tvSeats"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginStart="14dp"
                            android:textAppearance="@style/Type.BodyLarge"
                            android:textColor="@color/md_on_surface" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/md_outline_variant" />

                    <!-- Posted by row -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_person" app:tint="@color/md_primary" />
                        <TextView android:id="@+id/tvPostedBy"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginStart="14dp"
                            android:textAppearance="@style/Type.BodyLarge"
                            android:textColor="@color/md_on_surface" />
                    </LinearLayout>

                    <TextView android:id="@+id/tvVehicle"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:paddingBottom="12dp"
                        android:textAppearance="@style/Type.BodyMedium"
                        android:textColor="@color/md_on_surface_variant" />

                    <TextView android:id="@+id/tvStatus"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:textAppearance="@style/Type.LabelLarge"
                        android:textColor="@color/status_open" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Notes card (visibility toggled in Java) ────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNotes"
                style="@style/Widget.SAFAR.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/md_primary_container"
                app:cardCornerRadius="20dp"
                app:strokeWidth="0dp">
                <TextView android:id="@+id/tvNotes"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:padding="20dp"
                    android:textAppearance="@style/Type.BodyMedium"
                    android:textColor="@color/md_on_primary_container" />
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Owner actions (visibility set in Java) ─────────────── -->
            <LinearLayout android:id="@+id/layoutOwnerActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMarkFilled"
                        style="@style/Widget.SAFAR.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="Mark Filled" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDeleteAd"
                        style="@style/Widget.SAFAR.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Delete Ride"
                        app:backgroundTint="#C62828" />
                </LinearLayout>

            </LinearLayout>

            <!-- ── Requester actions (visibility set in Java) ─────────── -->
            <LinearLayout
                android:id="@+id/layoutRequesterActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCallDetail"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="12dp"
                    android:padding="0dp"
                    app:icon="@drawable/ic_phone"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/md_primary"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSendRequest"
                    style="@style/Widget.SAFAR.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="Request to Join" />

            </LinearLayout>

            <!-- ── Requests header (owner only) ──────────────────────── -->
            <TextView android:id="@+id/tvRequestsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:textAppearance="@style/Type.TitleMedium"
                android:text="Join Requests"
                android:textColor="@color/md_on_surface"
                android:visibility="gone" />

            <TextView android:id="@+id/tvNoRequests"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/Type.BodyMedium"
                android:text="No requests yet."
                android:textColor="@color/md_on_surface_variant"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRequests"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
