<?xml version="1.0" encoding="utf-8"?>
<!--
  MAP FRAGMENT - EXACT REPLICA OF THE REQUESTED UI
  ────────────
  • Fullscreen dark map.
  • Top: SAFAR (Yellow) + Notification Bell.
  • Search: Floating "Where are you going?" pill.
  • Action Cards: Explore (Dark), My Rides (Dark), Post Ride (Yellow).
  • Bottom Panel: Active Rides Nearby list with yellow headers and OPEN buttons.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background">

    <!-- 1. FULLSCREEN MAP -->
    <com.google.android.gms.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. TOP HEADER SECTION -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="52dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:clipToPadding="false">

        <TextView
            android:id="@+id/tvSafarLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SAFAR"
            android:textAppearance="@style/Type.HeadlineLarge"
            android:textColor="@color/md_primary"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"/>

        <!-- Notification Bell (Circular Dark) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnNotification"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            app:cardBackgroundColor="#2A2A2A"
            app:cardCornerRadius="22dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_notification"
                app:tint="@color/md_on_surface" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Search Bar: Floating Pill below Logo -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSearch"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_below="@id/tvSafarLogo"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#CC1E1E1E"
            app:cardCornerRadius="28dp"
            app:cardElevation="8dp"
            app:strokeWidth="1dp"
            app:strokeColor="#33FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/md_primary" />

                <TextView
                    android:id="@+id/etSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Where are you going?"
                    android:textAppearance="@style/Type.BodyLarge"
                    android:textColor="#9E9E9E" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </RelativeLayout>

    <!-- 3. MY LOCATION BUTTON
         UPDATED: Repositioned to replace the Explore button position
    -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btn_my_location"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="118dp"
        app:cardBackgroundColor="#1C1C1C"
        app:cardCornerRadius="14dp"
        app:cardElevation="12dp"
        app:strokeWidth="1dp"
        app:strokeColor="#44FFFFFF">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:scaleType="centerInside"
            android:src="@drawable/btnmylocation" />
    </com.google.android.material.card.MaterialCardView>

    <!-- 4. BOTTOM ACTION PANEL (Tiles + Rides) -->
    <LinearLayout
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@android:color/transparent">

        <!-- Tiles Row: My Rides, Post Ride (Yellow) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            android:weightSum="2">

            <!-- My Rides -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tileMyRides"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                app:cardBackgroundColor="#222222"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeWidth="1dp"
                app:strokeColor="#33FFFFFF">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_map"
                        app:tint="@color/md_primary" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="My Rides"
                        android:textAppearance="@style/Type.LabelLarge"
                        android:textColor="#FFFFFF" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Post Ride (Yellow Highlight) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tilePostRide"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                app:cardBackgroundColor="@color/md_primary"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_add"
                        app:tint="#000000" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Post Ride"
                        android:textAppearance="@style/Type.LabelLarge"
                        android:textColor="#000000"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Active Rides Nearby Panel -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="#1A1A1A"
            app:cardCornerRadius="28dp"
            app:cardElevation="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="#22FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <!-- Header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACTIVE RIDES NEARBY"
                        android:textAppearance="@style/Type.LabelSmall"
                        android:textColor="@color/md_primary"
                        android:letterSpacing="0.1" />
                    <TextView
                        android:id="@+id/btnSeeAllRides"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="See All"
                        android:textAppearance="@style/Type.LabelLarge"
                        android:textColor="#9E9E9E" />
                </RelativeLayout>

                <!-- Ride Item 1 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/rideRow1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardBackgroundColor="#222222"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#1AFFFFFF">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="10dp">
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivUser1"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_person"
                            android:padding="8dp"
                            android:background="#333333"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_toEndOf="@id/ivUser1"
                            android:layout_marginStart="12dp"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@id/btnOpen1">
                            <TextView
                                android:id="@+id/tvRide1Route"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="E-10, Islamabad → Centaurus"
                                android:textAppearance="@style/Type.TitleMedium"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold"
                                android:singleLine="true"
                                android:ellipsize="end" />
                            <TextView
                                android:id="@+id/tvRide1Meta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1 seat(s) | Mar 14, 03:57 AM"
                                android:textAppearance="@style/Type.BodyMedium"
                                android:textColor="#9E9E9E" />
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOpen1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="OPEN"
                            android:minWidth="70dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            app:backgroundTint="@color/md_primary"
                            android:textColor="#000000"
                            android:textAppearance="@style/Type.LabelLarge"
                            app:cornerRadius="10dp" />
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Ride Item 2 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/rideRow2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#222222"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#1AFFFFFF">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="10dp">
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivUser2"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_person"
                            android:padding="8dp"
                            android:background="#333333"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_toEndOf="@id/ivUser2"
                            android:layout_marginStart="12dp"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@id/btnOpen2">
                            <TextView
                                android:id="@+id/tvRide2Route"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="E-9, Islamabad → Orangi"
                                android:textAppearance="@style/Type.TitleMedium"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold"
                                android:singleLine="true"
                                android:ellipsize="end" />
                            <TextView
                                android:id="@+id/tvRide2Meta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1 seat(s) | Mar 27, 07:17 AM"
                                android:textAppearance="@style/Type.BodyMedium"
                                android:textColor="#9E9E9E" />
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOpen2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="OPEN"
                            android:minWidth="70dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            app:backgroundTint="@color/md_primary"
                            android:textColor="#000000"
                            android:textAppearance="@style/Type.LabelLarge"
                            app:cornerRadius="10dp" />
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/md_primary"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
