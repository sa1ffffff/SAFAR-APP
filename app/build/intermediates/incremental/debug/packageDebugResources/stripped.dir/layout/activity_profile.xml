<?xml version="1.0" encoding="utf-8"?>
<!--
  PROFILE
  ───────
  • AppBarLayout handles status bar padding.
  • Profile header uses a gradient container for visual depth.
  • Stats card uses a 2-column row with divider.
  • Action items are list-rows inside a surface card for iOS/Uber feel.
  • All IDs kept identical → no Java changes.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_surface"
        android:fitsSystemWindows="true"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.SAFAR.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Profile" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <!-- ── Profile header card ─────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SAFAR.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardBackgroundColor="@color/md_surface_variant"
                app:cardCornerRadius="24dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="28dp"
                    android:paddingBottom="24dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <!-- Avatar with yellow border -->
                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/ivAvatar"
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:src="@drawable/ic_person_placeholder"
                        app:civ_border_color="@color/md_primary"
                        app:civ_border_width="3dp" />

                    <TextView android:id="@+id/tvName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:textAppearance="@style/Type.TitleLarge"
                        android:text="Your Name"
                        android:textColor="@color/md_on_surface" />

                    <TextView android:id="@+id/tvPhone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/Type.BodyMedium"
                        android:textColor="@color/md_on_surface_variant" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Stats row ───────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="4dp">

                <!-- Total rides -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.SAFAR.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardBackgroundColor="@color/md_surface_variant"
                    app:cardCornerRadius="20dp"
                    app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">
                        <TextView android:id="@+id/tvTotalRides"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 rides"
                            android:textAppearance="@style/Type.TitleLarge"
                            android:textColor="@color/md_primary" />
                        <TextView android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Total Rides"
                            android:textAppearance="@style/Type.LabelMedium"
                            android:textColor="@color/md_on_surface_variant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Rating -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.SAFAR.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardBackgroundColor="@color/md_surface_variant"
                    app:cardCornerRadius="20dp"
                    app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">
                        <RatingBar android:id="@+id/ratingBar"
                            style="?android:attr/ratingBarStyleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:numStars="5"
                            android:stepSize="0.1"
                            android:isIndicator="true"
                            android:progressTint="@color/md_primary" />
                        <TextView android:id="@+id/tvRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="No ratings yet"
                            android:textAppearance="@style/Type.LabelMedium"
                            android:textColor="@color/md_on_surface_variant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ── Action rows card ────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SAFAR.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardBackgroundColor="@color/md_surface_variant"
                app:cardCornerRadius="20dp"
                app:strokeWidth="0dp">

                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- My posted rides row -->
                    <LinearLayout android:id="@+id/btnMyRides"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp"
                            android:src="@drawable/ic_map" app:tint="@color/md_primary"
                            android:layout_marginEnd="16dp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="@style/Type.BodyLarge"
                            android:text="My Posted Rides"
                            android:textColor="@color/md_on_surface" />
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/md_on_surface_variant" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/md_outline_variant"
                        android:layout_marginStart="58dp" />

                    <!-- Logout row -->
                    <LinearLayout android:id="@+id/btnLogout"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp"
                            android:src="@drawable/ic_person" app:tint="@color/md_error"
                            android:layout_marginEnd="16dp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="@style/Type.BodyLarge"
                            android:text="Logout"
                            android:textColor="@color/md_error" />
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/md_error" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Developer section ───────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="24dp"
                android:paddingBottom="8dp"
                android:textAppearance="@style/Type.LabelMedium"
                android:text="DEVELOPER"
                android:textColor="@color/md_on_surface_variant"
                android:letterSpacing="0.1" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SAFAR.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="@color/md_surface_variant"
                app:cardCornerRadius="20dp"
                app:strokeWidth="0dp">

                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="20dp">

                    <!-- Avatar initials circle -->
                    <LinearLayout android:layout_width="48dp" android:layout_height="48dp"
                        android:background="@drawable/bg_dev_circle"
                        android:gravity="center"
                        android:layout_marginEnd="16dp">
                        <TextView android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SW"
                            android:textColor="@color/md_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/Type.TitleMedium"
                            android:text="Saifullah Waseem"
                            android:textColor="@color/md_on_surface" />
                        <TextView android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/Type.BodyMedium"
                            android:text="SEECS '29"
                            android:textColor="@color/md_on_surface_variant" />
                    </LinearLayout>

                    <!-- GitHub icon button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGithub"
                        style="Widget.Material3.Button.IconButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:insetTop="0dp" android:insetBottom="0dp"
                        android:padding="0dp"
                        app:icon="@drawable/ic_github"
                        app:iconTint="@color/md_on_surface"
                        app:iconSize="22dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
