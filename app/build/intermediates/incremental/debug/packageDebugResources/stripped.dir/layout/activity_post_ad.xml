<?xml version="1.0" encoding="utf-8"?>
<!--
  POST A RIDE
  ───────────
  • AppBarLayout wrapping MaterialToolbar → handles status-bar height automatically.
  • fitsSystemWindows on AppBarLayout pushes content below status bar.
  • Each form field uses TextInputLayout (OutlinedBox) + TextInputEditText.
    IDs on inner TextInputEditText match originals → no Java changes.
  • NestedScrollView inside CoordinatorLayout enables proper scroll behaviour.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background"
    android:fitsSystemWindows="true">

    <!-- AppBar: handles status-bar padding automatically -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_surface"
        android:fitsSystemWindows="true"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.SAFAR.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Post a Ride"
            app:navigationIcon="@drawable/ic_chevron_right" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable form content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="32dp">

            <!-- FROM -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilOrigin"
                style="@style/Widget.SAFAR.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="From (e.g. Lahore)"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_map">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etOrigin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:singleLine="true"
                    android:textAppearance="@style/Type.BodyLarge"
                    android:textColor="@color/md_on_surface"
                    android:focusable="false"
                    android:clickable="true"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- TO -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDestination"
                style="@style/Widget.SAFAR.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="To (e.g. Islamabad)"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_map">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDestination"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:singleLine="true"
                    android:textAppearance="@style/Type.BodyLarge"
                    android:textColor="@color/md_on_surface"
                    android:focusable="false"
                    android:clickable="true"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- PHONE NUMBER -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPhone"
                style="@style/Widget.SAFAR.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="WhatsApp/Phone Number">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:singleLine="true"
                    android:textAppearance="@style/Type.BodyLarge"
                    android:textColor="@color/md_on_surface" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Date / time picker button -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="6dp"
                android:textAppearance="@style/Type.LabelMedium"
                android:text="DEPARTURE DATE &amp; TIME"
                android:textColor="@color/md_on_surface_variant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickDateTime"
                style="@style/Widget.SAFAR.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="start|center_vertical"
                android:paddingStart="16dp"
                android:text="Select Date &amp; Time"
                app:icon="@drawable/ic_time"
                app:iconGravity="textStart"
                app:iconPadding="12dp" />

            <TextView
                android:id="@+id/tvSelectedDateTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/Type.LabelLarge"
                android:textColor="@color/md_primary"
                android:visibility="gone" />

            <!-- SEATS -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.SAFAR.TextInput"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Seats (1-6)">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSeats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textAppearance="@style/Type.TitleMedium"
                    android:textColor="@color/md_on_surface" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- VEHICLE -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.SAFAR.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Vehicle details (optional)">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etVehicle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textAppearance="@style/Type.BodyLarge"
                    android:textColor="@color/md_on_surface" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- NOTES -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.SAFAR.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Notes (optional)">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:maxLines="5"
                    android:textAppearance="@style/Type.BodyLarge"
                    android:textColor="@color/md_on_surface" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Loading -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:indeterminateTint="@color/md_primary"
                android:visibility="gone" />

            <!-- Submit -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPost"
                style="@style/Widget.SAFAR.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="Post Ride"
                app:icon="@drawable/ic_add"
                app:iconGravity="textEnd"
                app:iconPadding="8dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
