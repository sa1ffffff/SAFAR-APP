<?xml version="1.0" encoding="utf-8"?>
<!--
  AD BOTTOM SHEET
  ───────────────
  • Background uses bg_bottom_sheet drawable (kept from original).
  • MD3 typography throughout.
  • Safety pill uses primary container colours instead of a custom drawable.
  • Buttons use proper MD3 styles.
  • All IDs unchanged.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="32dp">

    <!-- Drag handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_sheet_handle" />

    <!-- Route: large title -->
    <TextView android:id="@+id/tvRoute"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/Type.TitleLarge"
        android:text="Lahore → Islamabad"
        android:textColor="@color/md_on_surface" />

    <!-- Time row -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="12dp">
        <ImageView android:layout_width="16dp" android:layout_height="16dp"
            android:src="@drawable/ic_time" app:tint="@color/md_primary" />
        <TextView android:id="@+id/tvTime"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textAppearance="@style/Type.BodyMedium"
            android:text="Fri, 20 Jun • 08:00 AM"
            android:textColor="@color/md_on_surface_variant" />
    </LinearLayout>

    <!-- Seats + Posted by -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <ImageView android:layout_width="16dp" android:layout_height="16dp"
            android:src="@drawable/ic_seat" app:tint="@color/md_primary" />
        <TextView android:id="@+id/tvSeats"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="10dp"
            android:textAppearance="@style/Type.BodyMedium"
            android:text="2 seats available"
            android:textColor="@color/md_on_surface_variant" />

        <ImageView android:layout_width="16dp" android:layout_height="16dp"
            android:src="@drawable/ic_person" app:tint="@color/md_primary" />
        <TextView android:id="@+id/tvPostedBy"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textAppearance="@style/Type.BodyMedium"
            android:text="By Ali"
            android:textColor="@color/md_on_surface_variant" />
    </LinearLayout>

    <!-- Vehicle (optional) -->
    <TextView android:id="@+id/tvVehicle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="@style/Type.BodyMedium"
        android:textColor="@color/md_on_surface_variant"
        android:visibility="gone" />

    <!-- Divider -->
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:layout_marginTop="20dp" android:layout_marginBottom="16dp"
        android:background="@color/md_outline_variant" />

    <!-- Safety chip (MD3 primary container) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="@color/md_primary_container"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="12dp"
            android:textAppearance="@style/Type.LabelMedium"
            android:text="💡 Meet in public. Negotiate price before trip."
            android:textColor="@color/md_on_primary_container" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Action buttons -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewDetail"
            style="@style/Widget.SAFAR.Button.Outlined"
            android:layout_width="0dp" android:layout_height="52dp"
            android:layout_weight="1" android:layout_marginEnd="6dp"
            android:text="Details" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCall"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="52dp" android:layout_height="52dp"
            android:layout_marginEnd="6dp"
            android:padding="0dp"
            app:icon="@drawable/ic_phone"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/md_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRequestJoin"
            style="@style/Widget.SAFAR.Button.Primary"
            android:layout_width="0dp" android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Request" />

    </LinearLayout>

</LinearLayout>
