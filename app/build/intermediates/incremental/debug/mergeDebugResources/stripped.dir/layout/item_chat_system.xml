<?xml version="1.0" encoding="utf-8"?>
<!--
  CHAT SYSTEM MESSAGE
  ───────────────────
  • Centred pill using primary container colour.
  • ID unchanged.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <TextView
        android:id="@+id/tvSystemMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_safety_pill"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textAppearance="@style/Type.LabelMedium"
        android:textColor="@color/md_on_primary_container"
        android:gravity="center" />

</LinearLayout>
