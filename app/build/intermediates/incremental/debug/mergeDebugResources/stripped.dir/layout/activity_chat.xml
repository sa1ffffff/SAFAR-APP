<?xml version="1.0" encoding="utf-8"?>
<!--
  CHAT
  ────
  • AppBarLayout handles status-bar padding → toolbar never overlaps bar.
  • fitsSystemWindows="true" on root + windowSoftInputMode="adjustResize"
    in Manifest means the input bar rides above the keyboard.
  • RecyclerView takes remaining space (weight=1) and compresses with keyboard.
  • Input bar uses TextInputLayout for proper MD3 text field styling.
    etMessage ID kept → no Java changes.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md_background"
    android:fitsSystemWindows="true">

    <!-- AppBar with status-bar padding handled automatically -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_surface"
        android:fitsSystemWindows="true"
        app:elevation="4dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.SAFAR.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Safety banner -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/md_primary_container"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textAppearance="@style/Type.LabelMedium"
            android:text="@string/chat_disclaimer"
            android:textColor="@color/md_on_primary_container" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Messages list — compresses when keyboard appears -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false" />

    <!-- Input bar — stays above keyboard due to fitsSystemWindows + adjustResize -->
    <LinearLayout
        android:id="@+id/inputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/md_surface"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical"
        android:elevation="4dp">

        <!-- TextInputLayout for the message field -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.SAFAR.TextInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Message">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="5"
                android:imeOptions="actionSend"
                android:textAppearance="@style/Type.BodyLarge"
                android:textColor="@color/md_on_surface" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Send FAB-style button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSend"
            style="Widget.Material3.Button.IconButton.Filled"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:backgroundTint="@color/md_primary"
            app:icon="@drawable/ic_send"
            app:iconTint="@color/md_on_primary"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:shapeAppearanceOverlay="@style/ShapeSmall" />

    </LinearLayout>

</LinearLayout>
