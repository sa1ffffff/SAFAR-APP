<?xml version="1.0" encoding="utf-8"?>
<!--
  CHAT ITEM — RECEIVED
  ─────────────────────
  • Dark surface-variant bubble aligned to the left.
  • Sender name in primary yellow (md_primary) above message.
  • All IDs unchanged.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="start"
    android:paddingStart="12dp"
    android:paddingEnd="64dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bubble_received"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvSender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:textAppearance="@style/Type.LabelMedium"
            android:textColor="@color/md_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Type.BodyMedium"
            android:textColor="@color/bubble_text_received" />

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/Type.LabelSmall"
            android:textColor="@color/md_on_surface_variant" />

    </LinearLayout>
</LinearLayout>
