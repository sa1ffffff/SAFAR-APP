<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Phone Call Permission -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- GPS / Location permissions (Fix #1) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Notifications -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".SafarApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SAFAR"
        android:usesCleartextTraffic="false">

    
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="API_hidden_for_Safety_purposes" />

        <!-- Splash -->
        <activity
            android:name=".views.activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.SAFAR.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login (unified: phone + email + google) -->
        <activity
            android:name=".views.activities.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- OTP -->
        <activity
            android:name=".views.activities.OtpVerifyActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Password Setup (after phone OTP signup) -->
        <activity
            android:name=".views.activities.PasswordSetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Forgot Password -->
        <activity
            android:name=".views.activities.ForgotPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Phone Auth (used by LoginActivity) -->
        <activity
            android:name=".views.activities.PhoneAuthActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Safety guidelines -->
        <activity
            android:name=".views.activities.SafetyActivity"
            android:exported="false" />

        <!-- Main (holds Map, List, Inbox fragments) -->
        <activity
            android:name=".views.activities.MainActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- Post a Ride -->
        <activity
            android:name=".views.activities.PostAdActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Location picker (used by PostAdActivity) -->
        <activity
            android:name=".views.activities.LocationPickerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <!-- Ad Detail -->
        <activity
            android:name=".views.activities.AdDetailActivity"
            android:exported="false" />

        <!-- Chat -->
        <activity
            android:name=".views.activities.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- My Rides -->
        <activity
            android:name=".views.activities.MyAdsActivity"
            android:exported="false" />

        <!-- Profile / More -->
        <activity
            android:name=".views.activities.ProfileActivity"
            android:exported="false" />

        <!-- Settings -->
        <activity
            android:name=".views.activities.SettingsActivity"
            android:exported="false"
            android:label="Settings" />

        <!-- Help & FAQ -->
        <activity
            android:name=".views.activities.HelpActivity"
            android:exported="false" />

        <!-- About SAFAR -->
        <activity
            android:name=".views.activities.AboutActivity"
            android:exported="false"
            android:label="About SAFAR" />

        <!-- Review -->
        <activity
            android:name=".views.activities.ReviewActivity"
            android:exported="false"
            android:label="Rate Experience"
            android:windowSoftInputMode="adjustResize" />

        <!-- Notifications -->
        <activity
            android:name=".views.activities.NotificationsActivity"
            android:exported="false"
            android:label="Notifications" />

        <!-- User Profile (view other users) -->
        <activity
            android:name=".views.activities.UserProfileActivity"
            android:exported="false"
            android:label="Profile" />

        <!-- Firebase Cloud Messaging -->
        <service
            android:name=".firebase.SafarMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>
</manifest>
