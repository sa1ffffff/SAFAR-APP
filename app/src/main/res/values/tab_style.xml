<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Tab text style for the TabLayout in fragment_list.xml.
        textAllCaps false prevents "ALL RIDES" "MY CITY" forced uppercase.
        textSize 12sp fits 3 tabs comfortably on all screen widths.
    -->
    <style name="TabTextStyle" parent="@android:style/TextAppearance">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
