<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ═══ PRIMARY DARK THEME (SAFAR MD3) ══════════════════════════════ -->
    <style name="Theme.SAFAR" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- GLOBAL UI DESIGN SYSTEM -->
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>

        <!-- Background & Surfaces -->
        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorOnBackground">@color/md_on_background</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorOutline">@color/md_outline</item>

        <!-- STATUS BAR FIX (Edge-to-Edge) -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/md_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <!-- Typography -->
        <item name="textAppearanceHeadlineLarge">@style/Type.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/Type.HeadlineMedium</item>
        <item name="textAppearanceTitleLarge">@style/Type.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/Type.TitleMedium</item>
        <item name="textAppearanceBodyLarge">@style/Type.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/Type.BodyMedium</item>
        <item name="textAppearanceLabelLarge">@style/Type.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/Type.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/Type.LabelSmall</item>

        <!-- Component Styles -->
        <item name="bottomNavigationStyle">@style/Widget.SAFAR.BottomNav</item>
        <item name="floatingActionButtonStyle">@style/Widget.SAFAR.FAB</item>

        <!-- Shape Appearance -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeSmall</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeMedium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeLarge</item>
    </style>

    <!-- ═══ SPLASH THEME ══════════════════════════════════════════════════════ -->
    <style name="Theme.SAFAR.Splash" parent="Theme.SAFAR">
        <item name="android:windowBackground">@color/md_background</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- ═══ SHAPES ══════════════════════════════════════════════════════════ -->
    <style name="ShapeSmall">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>
    <style name="ShapeMedium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ShapeLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!-- ═══ TYPOGRAPHY (Scaled to ~70%) ══════════════════════════════════════ -->
    <style name="Type.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/md_on_background</item>
    </style>
    <style name="Type.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/md_on_background</item>
    </style>
    <style name="Type.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/md_on_surface</item>
    </style>
    <style name="Type.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/md_on_surface</item>
    </style>
    <style name="Type.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/md_on_surface</item>
    </style>
    <style name="Type.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/md_on_surface_variant</item>
    </style>
    <style name="Type.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/md_on_surface</item>
    </style>
    <style name="Type.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">8sp</item>
        <item name="android:textColor">@color/md_on_surface_variant</item>
    </style>
    <style name="Type.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">8sp</item>
        <item name="android:textColor">@color/md_on_surface_variant</item>
    </style>

    <!-- ═══ COMPONENT STYLES ══════════════════════════════════════════════ -->

    <!-- Bottom Navigation -->
    <style name="Widget.SAFAR.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/md_surface</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.SAFAR.BottomNav.Indicator</item>
    </style>
    <style name="Widget.SAFAR.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/md_primary_container</item>
    </style>

    <!-- FAB -->
    <style name="Widget.SAFAR.FAB" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/md_primary</item>
        <item name="tint">@color/md_on_primary</item>
    </style>

    <!-- Outlined TextInput -->
    <style name="Widget.SAFAR.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/md_primary</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <!-- Toolbar -->
    <style name="Widget.SAFAR.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/md_surface</item>
        <item name="titleTextColor">@color/md_on_surface</item>
        <item name="navigationIconTint">@color/md_on_surface</item>
        <item name="titleTextAppearance">@style/Type.TitleLarge</item>
    </style>

    <!-- Tab Layout -->
    <style name="Widget.SAFAR.TabText" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">10sp</item>
    </style>

    <!-- Primary Button -->
    <style name="Widget.SAFAR.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="shapeAppearance">@style/ShapeMedium</item>
        <item name="backgroundTint">@color/md_primary</item>
        <item name="android:textColor">@color/md_on_primary</item>
    </style>

    <!-- Outlined Button -->
    <style name="Widget.SAFAR.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="shapeAppearance">@style/ShapeMedium</item>
        <item name="strokeColor">@color/md_primary</item>
        <item name="android:textColor">@color/md_primary</item>
    </style>

    <!-- Cards -->
    <style name="Widget.SAFAR.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/md_surface_variant</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Legacy aliases so existing XML attributes don't break -->
    <style name="SafarButton" parent="Widget.SAFAR.Button.Primary" />
    <style name="SafarOutlineButton" parent="Widget.SAFAR.Button.Outlined" />
    <style name="SafarCard" parent="Widget.SAFAR.Card" />
    <style name="SafarToolbar" parent="Widget.SAFAR.Toolbar" />

</resources>
